DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jobprocess
JWT_SECRET_KEY=replace-with-a-long-random-secret
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
LOCAL_BLOB_DIRECTORY=.local-blobs
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=arq:queue
ARQ_MAX_ATTEMPTS=3
ARQ_JOB_TIMEOUT_SECONDS=1800
WORKER_LOCK_DIRECTORY=.worker-locks
CV_BLOB_CONTAINER=tailored-cvs
MAX_UPLOAD_SIZE_BYTES=10485760
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_PROFILE_BUILDER_MODEL=gpt-6-luna
OPENAI_JOB_NORMALIZER_MODEL=gpt-6-luna
OPENAI_JOB_MATCHING_MODEL=gpt-6-luna
OPENAI_CV_TAILORING_MODEL=gpt-6-luna
OPENAI_COVER_LETTER_TAILORING_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60